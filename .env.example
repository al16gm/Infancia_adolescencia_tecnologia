# URL base del sitio web (para SEO canónico y OpenGraph)
VITE_SITE_URL="https://lageneracionqueaprendio.com"

# Configuración de base de datos Supabase (opcional para desarrollo, necesaria para guardar emails en producción)
# Si se dejan vacías o con valores de ejemplo, la aplicación funciona en modo desarrollo local registrando en localStorage.
VITE_SUPABASE_URL="https://MY_SUPABASE_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_PUBLIC_KEY"

# GEMINI_API_KEY: Inyectada automáticamente por el entorno de Google AI Studio si se requieren servicios server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
